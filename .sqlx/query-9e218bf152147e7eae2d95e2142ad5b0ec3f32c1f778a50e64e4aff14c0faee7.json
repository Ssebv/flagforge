  "db_name": "PostgreSQL",
  "query": "\n        SELECT e.key, f.key AS flag_key, e.metric_key, e.control_variant, e.version\n        FROM experiments e\n        JOIN flags f ON f.id = e.flag_id\n        WHERE e.environment_id = $1 AND e.state = 'running'\n        ORDER BY e.key\n        ",
