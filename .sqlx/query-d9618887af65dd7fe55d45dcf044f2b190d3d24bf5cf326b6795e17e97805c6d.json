{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT k.id, k.environment_id, k.scope, e.project_id, p.organization_id\n        FROM api_keys k\n        JOIN environments e ON e.id = k.environment_id\n        JOIN projects p     ON p.id = e.project_id\n        WHERE k.key_hash = $1 AND k.revoked_at IS NULL\n        ",
