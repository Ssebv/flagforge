{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT f.key, f.variants, c.enabled, c.off_variant, c.fallthrough, c.rules, c.version\n        FROM flag_configs c\n        JOIN flags f ON f.id = c.flag_id\n        WHERE c.environment_id = $1 AND NOT f.archived\n        ORDER BY f.key\n        ",
