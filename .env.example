# Copy to .env for local development: `cp .env.example .env`

# Required. The server refuses to start without it.
DATABASE_URL=postgres://flagforge:flagforge@localhost:5432/flagforge

# Required. Must be at least 32 characters; generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-random-characters

# --- Optional, shown with their defaults ---------------------------------
# HOST=0.0.0.0
# PORT=8080
# APP_ENV=development          # `production` disables Swagger UI, logs JSON
# AUTO_MIGRATE=true            # apply pending migrations on boot
# DATABASE_MAX_CONNECTIONS=20
# REQUEST_TIMEOUT_SECS=15
# SHUTDOWN_GRACE_SECS=20
# BODY_LIMIT_BYTES=262144
# TOKEN_TTL_SECS=43200
# CACHE_REFRESH_SECS=60        # safety net; LISTEN/NOTIFY does the real work
# RATE_LIMIT_BURST=120
# RATE_LIMIT_PER_SECOND=40
# RUST_LOG=flagforge_api=debug,tower_http=debug,info
